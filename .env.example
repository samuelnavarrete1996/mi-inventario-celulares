# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - MI INVENTARIO POS (SAAS MULTI-TENANT)
# ==============================================================================

# 1. Base de Datos PostgreSQL (Supabase / Render / AWS RDS)
# Para Supabase, utiliza el Connection String con driver postgresql:// (modo Session o Transaction Pooler en puerto 6543 o 5432)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# (Opcional - Fallback a Turso Cloud SQLite si no se usa PostgreSQL)
# TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
# TURSO_AUTH_TOKEN=tu_token_largo_de_turso_aqui

# 2. Seguridad, Hashing y Tokens JWT
# Clave criptográfica para firma de tokens JWT (mínimo 32 caracteres generados al azar)
JWT_SECRET=super_secret_jwt_key_cambiar_obligatoriamente_en_produccion_1234567890

# Contraseña maestra de seguridad requerida para eliminar registros críticos (ventas/equipos)
ADMIN_DELETE_PASSWORD=contrasena_maestra_segura_de_eliminacion_2026

# 3. Entorno de Ejecución Cloud
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
AUTO_OPEN_BROWSER=0

# 4. Políticas de CORS (Cross-Origin Resource Sharing)
# Permite todos los orígenes (*) o dominios específicos separados por coma
CORS_ORIGINS=*
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
